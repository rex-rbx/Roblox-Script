    local HumanoidRootPart = (LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
    if TeleportLoopEnabled ~= true then
        TeleportLoopEnabled = true
        TeleportButton.Text = "Teleport Down"
        HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position.X, 173, HumanoidRootPart.Position.Z)
    else
