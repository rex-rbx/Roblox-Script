local CoreGui = game:GetService("CoreGui")
local _PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local LocalBaseDisplayName = LocalPlayer.DisplayName .. "\'s Base"
local TeleportLoopEnabled = false
local LocalPlotName = nil
local LocalBasePosition = nil
game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Net"):WaitForChild("RF/CoinsShopService/RequestBuy"):InvokeServer(unpack({
    "Speed Coil"
}))
task.spawn(function()
    local SpeedConnections = {}
    if Humanoid then
        Humanoid.WalkSpeed = 50
        SpeedConnections.WalkSpeedLoop = Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            Humanoid.WalkSpeed = 50
        end)
        SpeedConnections.CharacterAdded = LocalPlayer.CharacterAdded:Connect(function(NewCharacter)
            Character = NewCharacter
            Humanoid = NewCharacter:WaitForChild("Humanoid")
            Humanoid.WalkSpeed = 50
            if SpeedConnections.WalkSpeedLoop then
                SpeedConnections.WalkSpeedLoop:Disconnect()
            end
            SpeedConnections.WalkSpeedLoop = Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                Humanoid.WalkSpeed = 50
            end)
        end)
    end
end)
task.spawn(function()
    while true do
        local HumanoidRootPart = (LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
        if TeleportLoopEnabled then
            if math.floor(HumanoidRootPart.Position.Y + 0.5) ~= 173 then
                if math.floor(HumanoidRootPart.Position.Y + 0.5) ~= - 7 then
                    task.wait(0.1)
                else
                    HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position.X, 173, HumanoidRootPart.Position.Z)
                end
            else
                HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position.X, - 7, HumanoidRootPart.Position.Z)
                task.wait(0.2)
                HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position.X, 173, HumanoidRootPart.Position.Z)
                task.wait(0.5)
            end
        end
        wait(0.1)
    end
end)
