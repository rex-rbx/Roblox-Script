WalkToBaseButton.MouseButton1Click:Connect(function()
    if not LocalBasePosition then
        return
    end
    local CurrentCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local HumanoidRootPart = CurrentCharacter:WaitForChild("HumanoidRootPart")
    local Humanoid = CurrentCharacter:WaitForChild("Humanoid")
    while true do
        Humanoid:MoveTo(LocalBasePosition)
        local RootPos = HumanoidRootPart.Position
        if (Vector2.new(RootPos.X, RootPos.Z) - Vector2.new(LocalBasePosition.X, LocalBasePosition.Z)).Magnitude <= 1 then
            break
        end
        task.wait(0.1)
    end
end)
local Plots = workspace:FindFirstChild("Plots")
if not (Plots and Plots:IsA("Folder")) then
    return
end

for _, Plot in ipairs(Plots:GetChildren()) do
    if not Plot:IsA("Model") then
        continue
    end

    local Sign = Plot:FindFirstChild("PlotSign")
    local Label =
        Sign
        and Sign:FindFirstChildOfClass("SurfaceGui")
        and Sign.SurfaceGui:FindFirstChild("Frame")
        and Sign.SurfaceGui.Frame:FindFirstChild("TextLabel")

    if Label and Label:IsA("TextLabel") and Label.Text == LocalBaseDisplayName then
        LocalPlotName = Plot.Name

        local Decorations = Plot:FindFirstChild("Decorations")
        if Decorations and Decorations:IsA("Folder") then
            for _, Part in ipairs(Decorations:GetChildren()) do
                if Part:IsA("Part")
                    and Part.Name == "structure base home"
                    and Part.Color == Color3.fromRGB(0, 195, 0)
                then
                    LocalBasePosition = Part.Position
                    break
                end
            end
        end
        break
    end
end
local TextParts = {}
local FreezeData = {}

task.spawn(function()
    while true do
        for _, Plot in ipairs(Plots:GetChildren()) do
            if not Plot:IsA("Model") then
                continue
            end

            local Purchases = Plot:FindFirstChild("Purchases")
            local PlotBlock = Purchases and Purchases:FindFirstChild("PlotBlock")
            local Main = PlotBlock and PlotBlock:FindFirstChild("Main")
            local Gui = Main and Main:FindFirstChildOfClass("BillboardGui")
            local Label = Gui and Gui:FindFirstChild("RemainingTime")

            if Label and Label:IsA("TextLabel") then
                local Name = Plot.Name
                FreezeData[Name] = FreezeData[Name] or {
                    LastText = Label.Text,
                    TimeFreezed = 0
                }

                local Data = FreezeData[Name]
                if Label.Text ~= Data.LastText then
                    Data.LastText = Label.Text
                    Data.TimeFreezed = 0
                else
                    Data.TimeFreezed += 0.1
                end

                local DisplayText = Data.TimeFreezed >= 3 and "0s" or Label.Text

                if Name == LocalPlotName then
                    TimerLabel.Text = DisplayText
                else
                    local Part = TextParts[Name]
                    if not Part then
                        Part = Instance.new("Part")
                        Part.Size = Vector3.new(4, 1, 1)
                        Part.Anchored = true
                        Part.CanCollide = false
                        Part.Transparency = 1
                        Part.Name = "TextPart_" .. Name
                        Part.Parent = workspace

                        local Billboard = Instance.new("BillboardGui")
                        Billboard.Size = UDim2.new(0, 200, 0, 50)
                        Billboard.AlwaysOnTop = true
                        Billboard.LightInfluence = 0
                        Billboard.Adornee = Part
                        Billboard.Parent = Part

                        local Text = Instance.new("TextLabel")
                        Text.Size = UDim2.new(1, 0, 1, 0)
                        Text.BackgroundTransparency = 1
                        Text.TextScaled = true
                        Text.Font = Enum.Font.GothamBold
                        Text.TextColor3 = Color3.fromRGB(255, 255, 255)
                        Text.Parent = Billboard

                        TextParts[Name] = Part
                    end

                    Part.Position = Main.Position + Vector3.new(0, 5, 0)
                    Part.BillboardGui.TextLabel.Text = DisplayText
                end
            end
        end
        task.wait(0.1)
    end
end)
